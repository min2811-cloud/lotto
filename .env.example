# 이 파일을 복사해서 `.env` 로 이름을 바꾸고, 아래 값을 채우세요.
# `.env` 는 절대 공유하거나 커밋하지 않습니다.

# 구글 OAuth 클라이언트 (Google Cloud Console 에서 발급)
# credentials.json 파일을 프로젝트 폴더에 두는 방식을 쓰면 아래는 비워둬도 됩니다.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# 리포트를 받을 기본 이메일 주소
DEFAULT_REPORT_RECIPIENT=

# (선택) 결과물을 저장할 구글 드라이브 폴더 ID
DRIVE_OUTPUT_FOLDER_ID=
